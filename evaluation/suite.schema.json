{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/f0909172434/dsh-plugin-verified-search/blob/main/evaluation/suite.schema.json",
  "title": "Verified Search Offline Evaluation Suite",
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer", "equals"],
      "properties": {
        "pointer": {
          "type": "string",
          "pattern": "^(?:$|/)"
        },
        "equals": { "$ref": "#/$defs/jsonValue" }
      }
    },
    "expected": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "assertions"],
          "properties": {
            "status": { "const": "pass" },
            "assertions": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/assertion" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "code"],
          "properties": {
            "status": { "const": "error" },
            "code": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability", "operation", "payload", "expected"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,95}$"
        },
        "capability": {
          "enum": [
            "domain_filter",
            "json_date_selection",
            "json_numeric_selection",
            "json_projection"
          ]
        },
        "operation": {
          "enum": [
            "normalize_domains",
            "source_matches_domain",
            "filter_allowed_sources",
            "json_date_selection",
            "json_numeric_selection",
            "json_projection"
          ]
        },
        "payload": {
          "type": "object"
        },
        "expected": { "$ref": "#/$defs/expected" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "suiteId", "capability", "cases"],
  "properties": {
    "$schema": { "const": "./suite.schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "suiteId": { "type": "string", "minLength": 1 },
    "capability": {
      "enum": [
        "domain_filter",
        "json_date_selection",
        "json_numeric_selection",
        "json_projection"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  }
}
