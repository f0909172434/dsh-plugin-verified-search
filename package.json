{
  "name": "dsh-plugin-verified-search",
  "version": "0.3.0-experiment.0",
  "description": "Verified current-source search workflow for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./capabilities.json": "./capabilities.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "evaluation",
    "capabilities.json",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "MAINTENANCE.md",
    "docs/assets",
    "docs/COMPATIBILITY.md",
    "docs/HONEST_CI_DOGFOOD.md",
    "docs/OFFLINE_EVALUATION.md",
    "docs/PROPERTY_TESTING.md",
    "docs/capabilities.schema.json"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "evaluate:offline": "node ./lib/evaluate-offline.js --manifest evaluation/manifest.json --out work/offline-evaluation.json"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "web-search",
    "freshness"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f0909172434/dsh-plugin-verified-search.git"
  },
  "bugs": {
    "url": "https://github.com/f0909172434/dsh-plugin-verified-search/issues"
  },
  "homepage": "https://github.com/f0909172434/dsh-plugin-verified-search#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.6",
    "@deepseek-ai/dsh-launch-environment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-time-context": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-loop": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials-local": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-launch-environment": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@types/node": "^26.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.28.2"
}
