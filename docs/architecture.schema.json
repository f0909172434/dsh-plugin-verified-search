{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/f0909172434/dsh-plugin-verified-search/blob/main/docs/architecture.schema.json",
  "title": "Verified Search Source Architecture Contract",
  "$defs": {
    "layerName": {
      "enum": [
        "foundation",
        "engine",
        "harness",
        "cli",
        "composition"
      ]
    },
    "sourcePath": {
      "type": "string",
      "pattern": "^src/[A-Za-z0-9._/-]+\\.ts$"
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "purpose",
        "files",
        "may_import_layers"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/layerName"
        },
        "purpose": {
          "type": "string",
          "minLength": 20
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourcePath"
          }
        },
        "may_import_layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/layerName"
          }
        }
      }
    },
    "sizeException": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "baseline_bytes",
        "max_bytes",
        "target_bytes",
        "reason",
        "next_extraction",
        "removal_condition"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/sourcePath"
        },
        "baseline_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "target_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 30
        },
        "next_extraction": {
          "type": "string",
          "minLength": 30
        },
        "removal_condition": {
          "type": "string",
          "minLength": 30
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "baseline_commit",
    "source_root",
    "default_module_max_bytes",
    "dependency_rules",
    "layers",
    "size_exceptions"
  ],
  "properties": {
    "$schema": {
      "const": "./docs/architecture.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "baseline_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_root": {
      "const": "src"
    },
    "default_module_max_bytes": {
      "type": "integer",
      "minimum": 1000
    },
    "dependency_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_import_cycles",
        "unclassified_source_files",
        "unresolved_relative_imports",
        "harness_external_prefixes",
        "harness_external_import_layers"
      ],
      "properties": {
        "relative_import_cycles": {
          "const": "forbidden"
        },
        "unclassified_source_files": {
          "const": "forbidden"
        },
        "unresolved_relative_imports": {
          "const": "forbidden"
        },
        "harness_external_prefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "harness_external_import_layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/layerName"
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "size_exceptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sizeException"
      }
    }
  }
}
