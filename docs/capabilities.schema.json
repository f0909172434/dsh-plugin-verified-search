{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/f0909172434/dsh-plugin-verified-search/blob/main/docs/capabilities.schema.json",
  "title": "Verified Search Capability Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "package",
    "maintainer_model",
    "runtime_contract",
    "upstream_contract",
    "model_facing_tools",
    "evaluation_contract",
    "architecture_contract",
    "non_goals"
  ],
  "properties": {
    "$schema": {
      "const": "./docs/capabilities.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "main_version",
        "main_status",
        "reviewed_release"
      ],
      "properties": {
        "name": {
          "const": "dsh-plugin-verified-search"
        },
        "main_version": {
          "type": "string",
          "minLength": 1
        },
        "main_status": {
          "const": "unreleased_experiment"
        },
        "reviewed_release": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "package_version",
            "tools"
          ],
          "properties": {
            "tag": {
              "type": "string",
              "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "package_version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "tools": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            }
          }
        }
      }
    },
    "maintainer_model": {
      "const": "single_maintainer"
    },
    "runtime_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "package_manager",
        "ci_operating_systems"
      ],
      "properties": {
        "node": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "package_manager": {
          "type": "string",
          "pattern": "^pnpm@[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "ci_operating_systems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ubuntu-latest",
              "windows-latest",
              "macos-latest"
            ]
          }
        }
      }
    },
    "upstream_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cordis",
        "deepseek_harness",
        "compatibility_kind"
      ],
      "properties": {
        "cordis": {
          "type": "string",
          "minLength": 1
        },
        "deepseek_harness": {
          "type": "string",
          "minLength": 1
        },
        "compatibility_kind": {
          "const": "exact_peer_contract"
        }
      }
    },
    "model_facing_tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "lifecycle",
          "main_installation",
          "removal_condition"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "lifecycle": {
            "enum": [
              "reviewed_release",
              "beta",
              "experimental",
              "deprecated"
            ]
          },
          "first_reviewed_release": {
            "type": "string",
            "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "first_main_version": {
            "type": "string",
            "minLength": 1
          },
          "main_installation": {
            "type": "boolean"
          },
          "removal_condition": {
            "type": "string",
            "minLength": 20
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "lifecycle": {
                  "const": "reviewed_release"
                }
              }
            },
            "then": {
              "required": [
                "first_reviewed_release"
              ]
            },
            "else": {
              "required": [
                "first_main_version"
              ]
            }
          }
        ]
      }
    },
    "evaluation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_id",
        "manifest",
        "case_count",
        "network_access_required",
        "capability_case_counts"
      ],
      "properties": {
        "corpus_id": {
          "const": "verified-search-offline-v1"
        },
        "manifest": {
          "const": "evaluation/manifest.json"
        },
        "case_count": {
          "const": 42
        },
        "network_access_required": {
          "const": false
        },
        "capability_case_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "domain_filter",
            "json_date_selection",
            "json_numeric_selection",
            "json_projection"
          ],
          "properties": {
            "domain_filter": {
              "const": 11
            },
            "json_date_selection": {
              "const": 10
            },
            "json_numeric_selection": {
              "const": 10
            },
            "json_projection": {
              "const": 11
            }
          }
        }
      }
    },
    "architecture_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "schema",
        "source_root",
        "layer_count",
        "default_module_max_bytes",
        "size_exception_count",
        "relative_import_cycles",
        "unclassified_source_files"
      ],
      "properties": {
        "file": {
          "const": "architecture.json"
        },
        "schema": {
          "const": "docs/architecture.schema.json"
        },
        "source_root": {
          "const": "src"
        },
        "layer_count": {
          "const": 5
        },
        "default_module_max_bytes": {
          "const": 20000
        },
        "size_exception_count": {
          "const": 7
        },
        "relative_import_cycles": {
          "const": "forbidden"
        },
        "unclassified_source_files": {
          "const": "forbidden"
        }
      }
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  }
}
